{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "removeComments": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "express"]
  },
  "include": [
    "src/**/*",
    "../Desktop/taskflow-backend/taskflow-backend/src/utils/fileReader.ts",
    "../Desktop/taskflow-backend/taskflow-backend/src/models/serever.ts",
    "../Desktop/taskflow-backend/taskflow-backend/src/data/interfaces/task.interface.ts",
    "../Desktop/taskflow-backend/taskflow-backend/src/data/tasks.json"
  ],
  "exclude": ["node_modules", "dist"]
}
